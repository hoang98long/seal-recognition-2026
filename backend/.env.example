APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/seal_forensics
SESSION_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_REQUEST_TIMEOUT_SECONDS=90
OPENAI_MAX_COMPARE_CANDIDATES=5
OPENAI_MAX_IMAGE_SIDE=2048
STORAGE_ROOT=../data
FRONTEND_ORIGIN=http://localhost:5173
API_PORT=8000
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000
PDF_RENDER_SCALE=2
